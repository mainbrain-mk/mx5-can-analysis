#!/bin/sh
# Pre-push-Hook: ein Push zum Pi (Remote "car") geht nur durch, wenn der Commit
# schon in einem origin-Branch liegt. Sonst laeuft auf dem Pi Code, den es auf
# GitHub nicht gibt (Fall 26.09.2026, siehe docs/status/pi-runtime-state.md).
# Einrichten: ln -s ../../scripts/pi-config/git-pre-push .git/hooks/pre-push
[ "$1" = car ] || exit 0
while read -r _ sha _ _; do
    [ "$sha" = 0000000000000000000000000000000000000000 ] && continue
    if [ -z "$(git branch -r --contains "$sha" 2>/dev/null | grep 'origin/')" ]; then
        echo "pre-push: $sha liegt in keinem origin-Branch - erst nach GitHub pushen." >&2
        exit 1
    fi
done
